# DevTempMail (DTM) Environment Variables

# PostgreSQL Database URL (Neon / Supabase Serverless Pooler URL)
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devtempmail"

# Mail.tm API Base URL (Default: https://api.mail.tm)
NEXT_PUBLIC_MAILTM_API_URL="https://api.mail.tm"
